# ==============================================================================
# Lumbung Kopi dan Roti - Environment Variables Template
# ==============================================================================

# Supabase Credentials (Wajib)
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mayar Payment Gateway Configuration (Fitur Nilai Tambah QRIS Dinamis)
# Dapatkan dari Dashboard Sandbox Mayar: https://dashboard-sandbox.mayar.id
MAYAR_API_KEY=your-mayar-api-key
MAYAR_BASE_URL=https://api.mayar.io/hl/v2
